{
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/track/:id", "destination": "/api/track/[id]" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    }
  ]
}
